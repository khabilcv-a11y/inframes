{
  "name": "@inframe/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply inframe --local",
    "db:migrate:remote": "wrangler d1 migrations apply inframe --remote",
    "seed:super": "node scripts/seed-super-admin.mjs",
    "test": "node --experimental-strip-types --experimental-sqlite --test test/*.test.ts",
    "check": "tsc -p ."
  },
  "dependencies": {
    "@inframe/shared": "workspace:*",
    "hono": "^4.7.0",
    "jose": "^5.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
